### ==========================================
### АВТОРИЗАЦІЯ (Отримання токенів)
### ==========================================

### 1. Реєстрація нового користувача (POST)
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "email": "mike_test@mail.com",
  "password": "VerySecurePass123",
  "firstName": "Михайло",
  "lastName": "Борщівник"
}

> {%
    client.global.set("auth_token", response.body.accessToken);
    client.global.set("refresh_token", response.body.refreshToken);
%}

### 2. Логін користувача (POST)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "mike_test@mail.com",
  "password": "VerySecurePass123"
}

> {%
    client.global.set("auth_token", response.body.accessToken);
    client.global.set("refresh_token", response.body.refreshToken);
%}

### 3. Оновлення токена (POST)
POST http://localhost:8080/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refresh_token}}"
}

> {%
    client.global.set("auth_token", response.body.accessToken);
    client.global.set("refresh_token", response.body.refreshToken);
%}

### 4. Вихід з системи (POST)
POST http://localhost:8080/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh_token}}"
}
> {%
    // Очищаємо змінні після успішного виходу
    client.global.clear("auth_token");
    client.global.clear("refresh_token");
%}